# Sao chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env

# Chuỗi kết nối Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/songxanh?schema=public"

# Khoá ký phiên đăng nhập (JWT HS256). BẮT BUỘC phải có, nếu không app
# sẽ báo lỗi khi đăng nhập. Sinh một chuỗi ngẫu nhiên bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Tài khoản mẫu do prisma/seed.js tạo ra.
# KHÔNG dùng mật khẩu mặc định cho môi trường có người dùng thật.
SEED_ADMIN_EMAIL="admin@songxanh.local"
SEED_ADMIN_PASSWORD=""
SEED_USER_EMAIL="hocsinh@example.com"
SEED_USER_PASSWORD=""

# Đặt "false" để tắt hai nút đăng nhập demo trên trang đăng nhập.
ENABLE_DEMO_LOGIN="true"

# Khoá API cho tính năng AI (tuỳ chọn).
GEMINI_API_KEY=""
GROQ_API_KEY=""
# Model Groq cho chatbot. Để trống sẽ dùng openai/gpt-oss-120b.
# Groq hay khai tử model; khi chatbot báo "model does not exist" thì tra
# https://console.groq.com/docs/deprecations rồi điền model mới vào đây,
# không cần sửa code.
GROQ_MODEL=""
